# ============================================================
# Project-specific (ML / SER) — do NOT commit large binary data
# Paths starting with "/" are anchored to the repo root, so they
# do not accidentally match `src/data/`, `src/utils/.cache/`, etc.
# ============================================================

# Datasets — multi-GB raw audio, never commit
/data/
/datasets/
*.wav
*.mp3
*.flac
*.mp4
*.tar.gz
*.zip

# Model checkpoints & training outputs
/outputs/
/checkpoints/
/lightning_logs/
*.ckpt
*.pt
*.pth
*.bin
*.safetensors

# HuggingFace cache (project-local)
/.huggingface/

# Experiment tracking
/wandb/
/mlruns/
/tb_logs/
/tensorboard/

# Jupyter execution artifacts
*-checkpoint.ipynb

